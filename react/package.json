{
  "name": "@dialstack/sdk-react",
  "version": "3.0.0",
  "description": "React components and hooks for the DialStack SDK \u2014 call logs, voicemails, dial plan, softphone and onboarding",
  "license": "MIT",
  "type": "module",
  "author": "DialStack",
  "homepage": "https://github.com/dialstack/dialstack-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dialstack/dialstack-sdk.git",
    "directory": "react"
  },
  "bugs": {
    "url": "https://github.com/dialstack/dialstack-sdk/issues"
  },
  "keywords": [
    "dialstack",
    "voice",
    "telephony",
    "react",
    "softphone",
    "embedded-components"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./softphone": {
      "import": {
        "types": "./dist/softphone.d.ts",
        "default": "./dist/softphone.mjs"
      },
      "require": {
        "types": "./dist/softphone.d.cts",
        "default": "./dist/softphone.cjs"
      }
    },
    "./dial-plan": {
      "import": {
        "types": "./dist/dial-plan.d.ts",
        "default": "./dist/dial-plan.mjs"
      },
      "require": {
        "types": "./dist/dial-plan.d.cts",
        "default": "./dist/dial-plan.cjs"
      }
    },
    "./onboarding": {
      "import": {
        "types": "./dist/onboarding.d.ts",
        "default": "./dist/onboarding.mjs"
      },
      "require": {
        "types": "./dist/onboarding.d.cts",
        "default": "./dist/onboarding.cjs"
      }
    },
    "./ai-agent": {
      "import": {
        "types": "./dist/ai-agent.d.ts",
        "default": "./dist/ai-agent.mjs"
      },
      "require": {
        "types": "./dist/ai-agent.d.cts",
        "default": "./dist/ai-agent.cjs"
      }
    },
    "./call-logs": {
      "import": {
        "types": "./dist/call-logs.d.ts",
        "default": "./dist/call-logs.mjs"
      },
      "require": {
        "types": "./dist/call-logs.d.cts",
        "default": "./dist/call-logs.cjs"
      }
    },
    "./voicemails": {
      "import": {
        "types": "./dist/voicemails.d.ts",
        "default": "./dist/voicemails.mjs"
      },
      "require": {
        "types": "./dist/voicemails.d.cts",
        "default": "./dist/voicemails.cjs"
      }
    },
    "./call-history": {
      "import": {
        "types": "./dist/call-history.d.ts",
        "default": "./dist/call-history.mjs"
      },
      "require": {
        "types": "./dist/call-history.d.cts",
        "default": "./dist/call-history.cjs"
      }
    },
    "./phone-numbers": {
      "import": {
        "types": "./dist/phone-numbers.d.ts",
        "default": "./dist/phone-numbers.mjs"
      },
      "require": {
        "types": "./dist/phone-numbers.d.cts",
        "default": "./dist/phone-numbers.cjs"
      }
    },
    "./phone-number-ordering": {
      "import": {
        "types": "./dist/phone-number-ordering.d.ts",
        "default": "./dist/phone-number-ordering.mjs"
      },
      "require": {
        "types": "./dist/phone-number-ordering.d.cts",
        "default": "./dist/phone-number-ordering.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "typesVersions": {
    "*": {
      "softphone": [
        "./dist/softphone.d.ts"
      ],
      "dial-plan": [
        "./dist/dial-plan.d.ts"
      ],
      "onboarding": [
        "./dist/onboarding.d.ts"
      ],
      "ai-agent": [
        "./dist/ai-agent.d.ts"
      ],
      "call-logs": [
        "./dist/call-logs.d.ts"
      ],
      "voicemails": [
        "./dist/voicemails.d.ts"
      ],
      "call-history": [
        "./dist/call-history.d.ts"
      ],
      "phone-numbers": [
        "./dist/phone-numbers.d.ts"
      ],
      "phone-number-ordering": [
        "./dist/phone-number-ordering.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@dialstack/sdk-webrtc": "3.0.0",
    "canvas-confetti": "^1.9.4",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "libphonenumber-js": "^1.13.9"
  },
  "peerDependencies": {
    "@dialstack/sdk-js": ">=3.0.0 <4",
    "@xyflow/react": "^12.0.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "rollup-plugin-dts": "^6.5.1"
  }
}
