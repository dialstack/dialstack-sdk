{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "jest"],
    "paths": {
      "@dialstack/sdk-js": ["../js/dist/index.d.ts"],
      "@dialstack/sdk-webrtc": ["../webrtc/dist/index.d.ts"],
      "#storybook-fixtures/mock-instance": ["../js/src/__mocks__/mock-instance.ts"],
      "#storybook-fixtures/mock-data": ["../js/src/__mocks__/mock-data.ts"],
      "#storybook-fixtures/types": ["../js/src/__storybook__/types.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/__stories__/**",
    "**/__storybook__/**",
    "**/__test-helpers__/**"
  ]
}
