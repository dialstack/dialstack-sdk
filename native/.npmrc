install-links=true
legacy-peer-deps=true

# npm reads exactly one project .npmrc — the local prefix's — so the repo root's
# ignore-scripts=true does NOT reach this directory. Restated here so a
# `cd sdk/native && npm install` runs no lifecycle scripts from the ~300-package
# React Native tree, matching mobile/.npmrc, admin/.npmrc and docs/.npmrc.
ignore-scripts=true
