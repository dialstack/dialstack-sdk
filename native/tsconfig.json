{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@dialstack/sdk-react/core": ["../react/src/react/softphone/core/index.ts"],
      "@dialstack/sdk-webrtc": ["../webrtc/dist/index.d.ts"],
      "@dialstack/sdk-js": ["../js/dist/index.d.ts"],
      "@dialstack/sdk-js/pure": ["../js/dist/pure.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
