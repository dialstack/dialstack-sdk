{
  "name": "@dialstack/sdk-native",
  "version": "0.1.0",
  "description": "React Native softphone components for the DialStack SDK",
  "license": "MIT",
  "type": "module",
  "author": "DialStack",
  "homepage": "https://github.com/dialstack/dialstack-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dialstack/dialstack-sdk.git",
    "directory": "native"
  },
  "keywords": [
    "dialstack",
    "voice",
    "softphone",
    "react-native",
    "webrtc"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build && npm run check:package"
  },
  "peerDependencies": {
    "libphonenumber-js": "^1.13.6",
    "react": ">=19",
    "react-native": ">=0.81",
    "react-native-incall-manager": ">=4",
    "react-native-svg": ">=15",
    "react-native-webrtc": ">=124"
  },
  "peerDependenciesMeta": {
    "react-native-webrtc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "~19.2.0",
    "libphonenumber-js": "^1.13.8",
    "publint": "^0.3.24",
    "react": "19.2.7",
    "react-native": "^0.86.0",
    "react-native-incall-manager": "^4.2.1",
    "react-native-svg": "^15.15.4",
    "react-native-webrtc": "^124.0.7",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.2.3",
    "tslib": "^2.8.1",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
