{
  "name": "@dialstack/sdk-server",
  "version": "3.0.0",
  "description": "Node.js server client for the DialStack SDK — REST API, webhooks and media streams",
  "license": "MIT",
  "type": "module",
  "author": "DialStack",
  "homepage": "https://github.com/dialstack/dialstack-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dialstack/dialstack-sdk.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/dialstack/dialstack-sdk/issues"
  },
  "keywords": [
    "dialstack",
    "voice",
    "telephony",
    "server",
    "api",
    "webhooks"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "module": "./dist/index.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rollup -c",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@dialstack/sdk-js": "3.0.0"
  },
  "dependencies": {
    "@storybook/react": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@xyflow/react": "^12.11.3",
    "globals": "^17.11.0",
    "libphonenumber-js": "^1.13.11"
  }
}
