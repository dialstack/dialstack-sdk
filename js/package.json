{
  "name": "@dialstack/sdk-js",
  "version": "3.0.0",
  "description": "DialStack browser SDK — initialisation, REST client and the self-registering web components",
  "license": "MIT",
  "type": "module",
  "author": "DialStack",
  "homepage": "https://github.com/dialstack/dialstack-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dialstack/dialstack-sdk.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/dialstack/dialstack-sdk/issues"
  },
  "keywords": [
    "dialstack",
    "voice",
    "telephony",
    "web-components",
    "custom-elements"
  ],
  "types": "./dist/index.d.ts",
  "unpkg": "dist/dialstack.umd.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pure": {
      "import": {
        "types": "./dist/pure.d.ts",
        "default": "./dist/pure.mjs"
      },
      "require": {
        "types": "./dist/pure.d.cts",
        "default": "./dist/pure.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "typesVersions": {
    "*": {
      "pure": [
        "./dist/pure.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/index.mjs",
    "./dist/index.cjs",
    "./dist/dialstack.umd.js",
    "./src/index.ts",
    "./src/components/*.ts"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@storybook/react": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@xyflow/react": "^12.11.3",
    "globals": "^17.11.0",
    "libphonenumber-js": "^1.13.11"
  },
  "devDependencies": {
    "rollup-plugin-dts": "^6.5.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
