{
  "name": "@dialstack/sdk-dev",
  "private": true,
  "version": "2.0.0",
  "description": "Official JavaScript SDK for DialStack - Business Voice for Vertical SaaS",
  "keywords": [
    "dialstack",
    "voice",
    "telephony",
    "sip",
    "webrtc",
    "embedded-components",
    "react"
  ],
  "license": "MIT",
  "type": "module",
  "author": "DialStack",
  "homepage": "https://github.com/dialstack/dialstack-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dialstack/dialstack-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/dialstack/dialstack-sdk/issues"
  },
  "scripts": {
    "build": "npm run build --prefix js && npm run build --prefix webrtc && npm run build --prefix server && npm run build --prefix react",
    "clean": "rm -rf dist js/dist webrtc/dist server/dist react/dist",
    "typecheck": "npm run typecheck --prefix js && npm run typecheck --prefix webrtc && npm run typecheck --prefix server && npm run typecheck --prefix react && tsc --noEmit -p tsconfig.json",
    "check:deps": "node scripts/check-dependency-free.ts",
    "check:package": "npm run check:package --prefix js && npm run check:package --prefix webrtc && npm run check:package --prefix server && npm run check:package --prefix react",
    "lint": "eslint src scripts js/src react/src webrtc/src server/src native/src",
    "lint:fix": "eslint src scripts js/src react/src webrtc/src server/src native/src --fix",
    "format": "prettier --write src scripts js/src react/src webrtc/src server/src native/src",
    "format:check": "prettier --check src scripts js/src react/src webrtc/src server/src native/src",
    "precommit": "npm run format && npm run lint && npm run typecheck",
    "test": "jest",
    "test:watch": "jest --watch",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "test-storybook": "test-storybook",
    "test:e2e": "test-storybook --url http://localhost:6006 --testTimeout 120000",
    "test:e2e:firefox": "test-storybook --url http://localhost:6006 --testTimeout 120000 --browsers firefox",
    "test:e2e:webkit": "test-storybook --url http://localhost:6006 --testTimeout 120000 --browsers webkit",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:firefox && npm run test:e2e:webkit"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dagre": "^0.7.54",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@xyflow/react": "^12.11.5",
    "canvas-confetti": "^1.9.4",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "eslint": "^10.9.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "http-server": "^14.1.1",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "libphonenumber-js": "^1.13.12",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "semver": "^7.8.5",
    "storybook": "^10.2.13",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
