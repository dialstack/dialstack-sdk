+  private var callIdsByServerCallId: [String: UUID] = [:]
+  /// Claimed ids CallKit has not accepted yet: a report racing one in flight for
+  /// the same server call id must join it, not start a second call.
+  private var pendingCallIds: Set<UUID> = []
+  private let knownCallsLock = NSLock()
+
+  /// Claim `id` for `serverCallId`, or return the CallKit id already reported, or
+  /// being reported, for it. Atomic, so the push and the app's own report of one
+  /// call can't both create a CallKit call when they land together.
+  private func claimCall(_ id: UUID, serverCallId: String) -> UUID? {
+    guard !serverCallId.isEmpty else { return nil }
+    knownCallsLock.lock()
+    defer { knownCallsLock.unlock() }
+    if let existing = callIdsByServerCallId[serverCallId],
+      pendingCallIds.contains(existing)
+        || callController.callObserver.calls.contains(where: { $0.uuid == existing && !$0.hasEnded })
+    {
+      return existing
+    }
+    callIdsByServerCallId[serverCallId] = id
+    pendingCallIds.insert(id)
+    return nil
+  }
