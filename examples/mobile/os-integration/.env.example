# Copy to .env.local (gitignored) and fill in.
#
# The EXPO_PUBLIC_* values are inlined into the app bundle by Metro. The rest are
# read only by the local wake harness under scripts/ and never reach the device.

# --- app ---------------------------------------------------------------------
EXPO_PUBLIC_DIALSTACK_API_BASE_URL=https://api.dialstack.ai
EXPO_PUBLIC_DIALSTACK_USER_ID=user_replace_me
# A client_secret from POST /v1/user_sessions. Seeds the first launch; after that
# the app persists and refreshes its own token.
EXPO_PUBLIC_DIALSTACK_TOKEN=replace_me
# Where the app fetches a fresh token: scripts/wake-webhook-server.mjs. 10.0.2.2 is
# the host loopback as seen from the Android emulator; use your LAN IP on a device.
EXPO_PUBLIC_WAKE_REGISTRY_URL=http://10.0.2.2:8787

# --- local wake harness (scripts/) -------------------------------------------
# Stands in for the integrator backend: receives the call.mobile_push_wakeup
# webhook, mints a session, and sends the FCM data message that wakes the app.
DIALSTACK_SECRET_KEY=sk_live_replace_me
DIALSTACK_ACCOUNT=acct_replace_me
# Only the POST /v1/webhook_endpoints create response returns this. Unset, the
# harness accepts webhooks unsigned and warns — acceptable for a local rig behind a
# rotating tunnel, never for a deployed server.
DIALSTACK_WEBHOOK_SECRET=

# --- Firebase ----------------------------------------------------------------
# The project that owns google-services.json, plus a service-account key with the
# FCM scope. Both are yours; neither is committed.
FCM_PROJECT_ID=replace_me
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
