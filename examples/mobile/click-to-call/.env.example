# Copy to .env.local (gitignored) and fill in.
#
# EXPO_PUBLIC_* is inlined into the app bundle by Metro. The rest is read only by
# the local rig under scripts/ and never reaches the device.

# --- app ---------------------------------------------------------------------
# Where the app reaches the rig. 10.0.2.2 is the host loopback as seen from the
# Android emulator; on a device use `adb reverse tcp:8788 tcp:8788` and
# http://127.0.0.1:8788, the iOS simulator's http://localhost:8788, or your Mac's
# LAN address from an iPhone.
EXPO_PUBLIC_RIG_URL=http://10.0.2.2:8788

# --- local rig (scripts/) ----------------------------------------------------
# Stands in for the integrator backend: it holds the secret key and is the only
# thing that talks to DialStack.
DIALSTACK_API_BASE_URL=https://api.dialstack.ai
DIALSTACK_SECRET_KEY=sk_live_replace_me
DIALSTACK_ACCOUNT=acct_replace_me
# Only the POST /v1/webhook_endpoints create response returns this. Unset, the
# rig accepts webhooks unsigned and warns — acceptable for a local rig behind a
# rotating tunnel, never for a deployed server.
DIALSTACK_WEBHOOK_SECRET=
